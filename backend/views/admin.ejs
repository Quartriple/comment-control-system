<div class="admin-dashboard">
  <div class="admin-header">
    <h1 class="admin-title">관리자 대시보드</h1>
    <div class="admin-actions">
      <a class="admin-btn admin-secondary-btn" href="/">게시판 목록</a>
      <form method="post" action="/user/logout" style="display:inline;">
        <button class="admin-btn admin-secondary-btn" type="submit">로그아웃</button>
      </form>
    </div>
  </div>
  
  <!-- Metrics Cards -->
  <div class="admin-metrics-row">
    <div class="admin-metric-card">
      <div class="admin-metric-title">총 게시물 수</div>
      <div class="admin-metric-value"><%= postCount %></div>
    </div>
    <div class="admin-metric-card">
      <div class="admin-metric-title">총 댓글 수</div>
      <div class="admin-metric-value"><%= commentCount %></div>
    </div>
    <div class="admin-metric-card">
      <div class="admin-metric-title">총 사용자 수</div>
      <div class="admin-metric-value"><%= userCount %></div>
    </div>
  </div>

  <!-- Recent Posts Section -->
  <div class="admin-section">
    <h2 class="admin-section-title">최근 게시물</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>제목</th>
          <th>작성자</th>
          <th>작성일</th>
          <th>조회수</th>
          <th>좋아요</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentPosts.length > 0) { %>
          <% recentPosts.forEach(post => { %>
            <tr>
              <td><%= post.id %></td>
              <td><a href="/posts/<%= post.id %>"><%= post.title %></a></td>
              <td><%= post.User ? post.User.nickname : '익명' %></td>
              <td><%= new Date(post.createdAt).toLocaleDateString('ko-KR') %></td>
              <td><%= post.views %></td>
              <td><%= post.likes %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="admin-no-data">최근 게시물이 없습니다.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Comments Management Section -->
  <div class="admin-section">
    <h2 class="admin-section-title">모든 댓글 관리</h2>
    <div class="admin-filter-controls">
      <form id="admin-filter-form" action="/admin" method="GET">
        <select name="veracity" onchange="this.form.submit()">
          <option value="" <%= !veracity ? 'selected' : '' %>>진실성 필터</option>
          <option value="TRUE" <%= veracity === 'TRUE' ? 'selected' : '' %>>TRUE</option>
          <option value="FALSE" <%= veracity === 'FALSE' ? 'selected' : '' %>>FALSE</option>
          <option value="UNSURE" <%= veracity === 'UNSURE' ? 'selected' : '' %>>UNSURE</option>
        </select>
        <input type="text" name="topic" placeholder="주제 필터" value="<%= topic %>">
        <select name="sortOrder" onchange="this.form.submit()">
          <option value="DESC" <%= sortOrder === 'DESC' ? 'selected' : '' %>>최신순</option>
          <option value="ASC" <%= sortOrder === 'ASC' ? 'selected' : '' %>>오래된순</option>
        </select>
      </form>
    </div>
    <table class="admin-table admin-comments-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>내용</th>
          <th>작성자</th>
          <th>증오 점수</th>
          <th>진실성</th>
          <th>주제</th>
          <th>작성일</th>
          <th>관리</th>
        </tr>
      </thead>
      <tbody>
        <% if (comments.length > 0) { %>
          <% comments.forEach(comment => { %>
            <tr class="comment-row" onclick="toggleDetails(this)">
              <td><%= comment.id %></td>
              <td class="admin-comment-content"><%= comment.content %></td>
              <td><%= comment.User ? comment.User.nickname : '익명' %></td>
              <td class="admin-hate-score"><%= comment.hate_score %></td>
              <td><%= comment.veracity %></td>
              <td><%= comment.topic || '-' %></td>
              <td><%= new Date(comment.createdAt).toLocaleDateString('ko-KR') %></td>
              <td>
                <form method="post" action="/comments/<%= comment.id %>/delete" onsubmit="return confirm('이 댓글을 삭제하시겠습니까?')" style="display:inline;">
                  <button type="submit" class="admin-btn admin-small-btn admin-danger-btn">삭제</button>
                </form>
              </td>
            </tr>
            <tr class="comment-details" style="display:none;">
              <td colspan="8">
                <div class="details-content">
                  <div class="detail-item">
                    <strong>진실성 근거:</strong>
                    <span><%= comment.veracity_reasoning || '근거 없음' %></span>
                  </div>
                  <div class="detail-item">
                    <strong>혐오 표현 분석:</strong>
                    <span><%= comment.hate_reasoning || '분석 없음' %></span>
                  </div>
                  <% if (comment.source) { %>
                    <div class="detail-item">
                      <strong>출처:</strong>
                      <a href="<%= comment.source %>" target="_blank"><%= comment.source %></a>
                    </div>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="8" class="admin-no-data">댓글이 없습니다.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function toggleDetails(row) {
      const detailsRow = row.nextElementSibling;
      detailsRow.style.display = detailsRow.style.display === 'none' ? 'table-row' : 'none';
      row.classList.toggle('active');
  }
</script>