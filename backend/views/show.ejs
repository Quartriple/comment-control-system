<div class="post-view-container">
  <div class="card">
    <h1>
      <%= post.title %>
    </h1>
    <div class="meta">
      <span>작성자: <strong>
          <%= post.User ? post.User.nickname : '익명' %>
        </strong></span>
      <span>조회수 <%= post.views %></span>
      <span>좋아요 <%= post.likes %></span>
      <span>작성일 <%= new Date(post.createdAt).toLocaleDateString('ko-KR') %></span>
    </div>
    <div class="show-content">
      <%= post.content || '' %>
    </div>
    <div class="actions">
      <% if (user && (user.id===post.userId)) { %>
        <a class="btn primary" href="/post/<%= post.id %>/edit">게시물 수정</a>
        <% } %>
          <% if (user && (user.id===post.userId || user.is_admin)) { %>
            <form id="delete-post-form" method="post" onsubmit="return false;" style="display:inline;">
              <button class="btn danger" type="submit">게시물 삭제</button>
            </form>

            <% } %>
              <a class="btn secondary" href="/">목록</a>
    </div>
  </div>

  <div class="comments-section card">
    <h3>댓글</h3>
    <% if (post.Comments && post.Comments.length) { %>
      <% post.Comments.forEach(function(c){ %>
        <div class="comment-item" id="comment-<%= c.id %>">
          <div class="comment-header">
            <span class="comment-author">
              <strong>
                <%= c.User ? c.User.nickname : '익명' %>
              </strong>
            </span>
            <span class="comment-date">
              <%= new Date(c.createdAt).toLocaleString('ko-KR') %>
            </span>
            <% if (user) { %>
              <span class="comment-actions">
                <button onclick="toggleCommentActions(<%= c.id %>)" class="btn-small btn-more">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                    <path
                      d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm7 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-14 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                  </svg>
                </button>
                <div class="comment-actions-dropdown" id="actions-<%= c.id %>" style="display:none;">
                  <% if (user.id===c.userId) { %>
                    <button type="button" onclick="editComment(<%= c.id %>)" class="btn-small btn-edit">수정</button>
                    <form method="post" action="/comments/<%= c.id %>/delete" onsubmit="return confirm('댓글을 삭제하시겠습니까?')"
                      class="delete-form">
                      <button type="submit" class="btn-small btn-delete">삭제</button>
                    </form>
                    <% } else if (user.is_admin) { %>
                      <form method="post" action="/comments/<%= c.id %>/delete"
                        onsubmit="return confirm('댓글을 삭제하시겠습니까?')" class="delete-form">
                        <button type="submit" class="btn-small btn-delete">삭제</button>
                      </form>
                      <% } else { %>
                        <button type="button" onclick="reportComment(<%= c.id %>)"
                          class="btn-small btn-report">신고하기</button>
                        <% } %>
                </div>
              </span>
              <% } %>
          </div>
        </div>
        <div class="comment-content">
          <%= c.content %>
        </div>
        <div class="comment-edit-form" style="display:none;">
          <form onsubmit="saveComment(event, <%= c.id %>, <%= post.id %>)">
            <textarea name="content" required><%= c.content %></textarea>
            <div class="actions">
              <button type="submit" class="btn-small btn-save">저장</button>
              <button type="button" onclick="cancelEdit(<%= c.id %>)" class="btn-small btn-cancel">취소</button>
            </div>
          </form>
        </div>
        <% }) %>
          <% } else { %>
            <div class="no-comments">아직 댓글이 없습니다.</div>
            <% } %>

              <% if (user) { %>
                <form class="new-comment-form" method="post" action="/comments">
                  <input type="hidden" name="postId" value="<%= post.id %>" />
                  <label for="comment-content">댓글 작성</label>
                  <textarea id="comment-content" name="content" placeholder="댓글을 입력하세요..." required></textarea>
                  <div class="actions">
                    <button class="btn btn-primary" type="submit">댓글 등록</button>
                  </div>
                </form>
                <% } else { %>
                  <div class="login-prompt">
                    댓글을 작성하려면 <a href="/user/login">로그인</a>해주세요.
                  </div>
                  <% } %>
  </div>
</div>

<script>
  function editComment(commentId) {
    const commentItem = document.getElementById('comment-' + commentId);

    const content = commentItem.nextElementSibling;
    const editForm = content.nextElementSibling;

    const dropdown = document.getElementById('actions-' + commentId);

    content.style.display = 'none';
    editForm.style.display = 'block';

    if (dropdown) {
      dropdown.style.display = 'none';
    }
  }

  function cancelEdit(commentId) {
    const commentItem = document.getElementById('comment-' + commentId);

    const content = commentItem.nextElementSibling;
    const editForm = content.nextElementSibling;

    content.style.display = 'block';
    editForm.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', () => {
    const deleteForm = document.getElementById('delete-post-form');
    if (deleteForm) {
      deleteForm.addEventListener('submit', async (e) => {
        e.preventDefault(); // 기본 폼 제출 방지
        const confirmed = confirm('게시물을 삭제하시겠습니까?');

        if (confirmed) {
          const postId = window.location.pathname.split('/').pop();
          try {
            const response = await fetch(`/post/${postId}`, {
              method: 'DELETE',
            });

            if (response.ok) {
              window.location.href = '/'; // 성공 시 게시물 목록 페이지로 리다이렉션
            } else {
              const errorData = await response.json();
              alert('삭제 실패: ' + errorData.message);
            }
          } catch (error) {
            console.error('Error during deletion:', error);
            alert('서버 요청 중 오류가 발생했습니다.');
          }
        }
      });
    }
  });

  async function saveComment(event, commentId) {
    event.preventDefault(); // 폼 제출 기본 동작 방지

    const form = event.target;
    const content = form.querySelector('textarea[name="content"]').value;

    try {
      const response = await fetch(`/comments/${commentId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ content: content }),
      });

      if (response.ok) {
        window.location.reload(); // 성공 시 페이지 새로고침
      } else {
        const errorData = await response.json();
        alert('댓글 수정 실패: ' + errorData.message);
      }
    } catch (error) {
      console.error('Error:', error);
      alert('서버 요청 중 오류가 발생했습니다.');
    }
  }

  function reportComment(commentId) {
    alert(`댓글 ID ${commentId}를 신고했습니다. (신고 로직은 서버에 별도 구현 필요)`);
    // 신고 후 드롭다운 닫기
    document.getElementById('actions-' + commentId).style.display = 'none';
  }

  function toggleCommentActions(commentId) {
    const dropdown = document.getElementById('actions-' + commentId);

    // 현재 드롭다운 상태 확인
    if (dropdown.style.display === 'none' || dropdown.style.display === '') {
      // 다른 모든 드롭다운 닫기
      document.querySelectorAll('.comment-actions-dropdown').forEach(d => {
        d.style.display = 'none';
      });
      // 현재 드롭다운 열기
      dropdown.style.display = 'inline-flex'; // 버튼들을 가로로 표시
    } else {
      // 현재 드롭다운 닫기
      dropdown.style.display = 'none';
    }
  }

  // 드롭다운 외부 클릭 시 닫기
  document.addEventListener('click', (event) => {
    const isMoreButton = event.target.closest('.btn-more');
    const isDropdown = event.target.closest('.comment-actions-dropdown');

    // 만약 클릭한 요소가 더보기 버튼도 아니고 드롭다운 자체도 아니라면 모두 닫기
    if (!isMoreButton && !isDropdown) {
      document.querySelectorAll('.comment-actions-dropdown').forEach(d => {
        d.style.display = 'none';
      });
    }
  });


</script>